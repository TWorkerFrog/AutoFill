/* ============================================
   ТЁМНАЯ ТЕМА (по умолчанию)
   ============================================ */

QMainWindow {
    background-color: #222222;
}

QLineEdit, QTextEdit, QSpinBox, QComboBox {
    selection-background-color: #7F43E3;
    selection-color: #F2F2F2;
}

QWidget {
    background-color: #222222;
    color: #F2F2F2;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #3A3A3A;
    background-color: #222222;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #2A2A2A;
    color: #F2F2F2;
    padding: 8px 18px;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 8px 15px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton#primary_btn {
    background-color: #7F43E3;
    color: #F2F2F2;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    border: none;
}

QPushButton#primary_btn:hover {
    background-color: #AD83F3;
}

QLineEdit, QTextEdit, QSpinBox {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 5px;
    border-radius: 4px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border-color: #7F43E3;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #7F43E3;
    border-color: #3A3A3A;
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/check.svg");
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/radio-checked.svg");
    background-color: #2A2A2A;
    border-color: #3A3A3A;
}

QLabel {
    color: #F2F2F2;
}

QDialog {
    background-color: #222222;
}

QSpinBox::up-button{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-up.svg");
    width: 20px;
    border-radius: 3px;
}
QSpinBox::down-button{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-down.svg");
    width: 20px;
    border-radius: 3px;
}

QSpinBox::up-button:hover {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-up-hover.svg");
}

QSpinBox::down-button:hover{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-down-hover.svg");
    width: 20px;
    border-radius: 3px;
}

QComboBox {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 5px;
    border-radius: 4px;
}

QComboBox:focus {
    border-color: #7F43E3;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-down.svg");
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    padding-right: 10px;
}
QComboBox::down-arrow:hover {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/BlackTheme/arrow-down-hover.svg");
}

QScrollBar:vertical {
    background-color: #2A2A2A;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4A;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7F43E3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;

}

QScrollBar:horizontal {
    background-color: #2A2A2A;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4A;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7F43E3;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QListView {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 5px;
}

QListView::item {
    padding: 5px;
}

QListView::item:hover {
    background-color: #3A3A3A;
}

QListView::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QHBoxLayout {
    spacing: 5px;
}

/* ============================================
   СВЕТЛАЯ ТЕМА
   ============================================ */

QMainWindow[theme="light"] {
    background-color: #F2F2F2;
}
QLineEdit[theme="light"], QTextEdit[theme="light"], QSpinBox[theme="light"], QComboBox[theme="light"] {
    selection-background-color: #7F43E3;
    selection-color: #F2F2F2;
}

QWidget[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
}

QTabWidget[theme="light"]::pane {
    border: 1px solid #CCCCCC;
    background-color: #F2F2F2;
}

QTabBar[theme="light"]::tab {
    background-color: #E0E0E0;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QTabBar[theme="light"]::tab:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton[theme="light"] {
    background-color: #E0E0E0;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QPushButton[theme="light"]:hover {
    background-color: #D0D0D0;
}

QPushButton[theme="light"]:pressed {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton[theme="light"]#primary_btn {
    background-color: #7F43E3;
    color: #F2F2F2;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    border: none;
}

QLineEdit[theme="light"], QTextEdit[theme="light"], QSpinBox[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}



QCheckBox[theme="light"]::indicator {
    width: 18px;
    height: 18px;
    background-color: #F2F2F2;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

QCheckBox[theme="light"]::indicator:checked {
    background-color: #7F43E3;
    border-color: #CCCCCC;
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/check.svg");
}

QRadioButton[theme="light"]::indicator {
    width: 18px;
    height: 18px;
    background-color: #F2F2F2;
    border: 1px solid #CCCCCC;
    border-radius: 9px;
}

QRadioButton[theme="light"]::indicator:checked {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/radio-checked.svg");
    background-color: #F2F2F2;
    border-color: #CCCCCC;
}

QLabel[theme="light"] {
    color: #0D0D0D;
}

QDialog[theme="light"] {
    background-color: #F2F2F2;
}

QSpinBox[theme="light"]::up-button{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-up.svg");
    width: 20px;
    border-radius: 3px;
}
QSpinBox[theme="light"]::down-button{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-down.svg");
    width: 20px;
    border-radius: 3px;
}

QSpinBox[theme="light"]::up-button:hover {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-up-hover.svg");
}

QSpinBox[theme="light"]::down-button:hover{
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-down-hover.svg");
    width: 20px;
    border-radius: 3px;
}

QComboBox[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
    padding: 5px;
    border-radius: 4px;
}

QComboBox[theme="light"]:focus {
    border-color: #7F43E3;
}

QComboBox[theme="light"]::drop-down {
    border: none;
    width: 20px;
}

QComboBox[theme="light"]::down-arrow {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-down.svg");
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    padding-right: 10px;
}
QComboBox[theme="light"]::down-arrow:hover {
    image: url("C:/Users/Alex/Documents/GitHub/AutoFillSurnames/icons/LightTheme/arrow-down-hover.svg");
}

QScrollBar[theme="light"]:vertical {
    background-color: #F2F2F2;
}

QScrollBar[theme="light"]::handle:vertical {
    background-color: #CCCCCC;
}

QScrollBar[theme="light"]::handle:vertical:hover {
    background-color: #7F43E3;
}


QScrollBar[theme="light"]:horizontal {
    background-color: #F2F2F2;
}

QScrollBar[theme="light"]::handle:horizontal {
    background-color: #CCCCCC;
}

QScrollBar[theme="light"]::handle:horizontal:hover {
    background-color: #7F43E3;
}

QListView[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QListView[theme="light"]::item:hover {
    background-color: #D0D0D0;
}

QListView[theme="light"]::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QHBoxLayout[theme="light"] {
    spacing: 5px;
}