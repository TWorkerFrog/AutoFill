/* ============================================
   ТЁМНАЯ ТЕМА (по умолчанию)
   ============================================ */

QMainWindow {
    background-color: #222222;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox {
    selection-background-color: #7F43E3;
    selection-color: #F2F2F2;
}

QWidget {
    background-color: #222222;
    color: #F2F2F2;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #3A3A3A;
    background-color: #222222;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #2A2A2A;
    color: #F2F2F2;
    padding: 8px 18px;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 8px 15px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton#primary_btn {
    background-color: #7F43E3;
    color: #F2F2F2;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    border: none;
}

QPushButton#primary_btn:hover {
    background-color: #AD83F3;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 5px;
    border-radius: 4px;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border-color: #7F43E3;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #7F43E3;
    border-color: #3A3A3A;
    image: url(":/icons/BlackTheme/check.png");
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    image: url(":/icons/BlackTheme/radio-checked.png");
    background-color: #2A2A2A;
    border-color: #3A3A3A;
}

QLabel {
    color: #F2F2F2;
}

QDialog {
    background-color: #222222;
}

QSpinBox::up-button {
    image: url(":/icons/BlackTheme/arrow-up.png");
    width: 20px;
    border-radius: 3px;
}

QSpinBox::down-button {
    image: url(":/icons/BlackTheme/arrow-down.png");
    width: 20px;
    border-radius: 3px;
}

QSpinBox::up-button:hover {
    image: url(":/icons/BlackTheme/arrow-up-hover.png");
}

QSpinBox::down-button:hover {
    image: url(":/icons/BlackTheme/arrow-down-hover.png");
    width: 20px;
    border-radius: 3px;
}

QComboBox {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 5px;
    border-radius: 4px;
}

QComboBox:focus {
    border-color: #7F43E3;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(":/icons/BlackTheme/arrow-down.png");
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    padding-right: 10px;
}

QComboBox::down-arrow:hover {
    image: url(":/icons/BlackTheme/arrow-down-hover.png");
}

QScrollBar:vertical {
    background-color: #2A2A2A;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4A;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7F43E3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #2A2A2A;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4A;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7F43E3;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QListView {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 5px;
}

QListView::item {
    padding: 5px;
}

QListView::item:hover {
    background-color: #3A3A3A;
}

QListView::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

/* ============================================
   СВЕТЛАЯ ТЕМА
   ============================================ */

QMainWindow[theme="light"] {
    background-color: #F2F2F2;
}

QLineEdit[theme="light"], QPlainTextEdit[theme="light"], QTextEdit[theme="light"], QSpinBox[theme="light"], QComboBox[theme="light"] {
    selection-background-color: #7F43E3;
    selection-color: #F2F2F2;
}

QWidget[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
}

QTabWidget[theme="light"]::pane {
    border: 1px solid #CCCCCC;
    background-color: #F2F2F2;
}

QTabBar[theme="light"]::tab {
    background-color: #E0E0E0;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QTabBar[theme="light"]::tab:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton[theme="light"] {
    background-color: #E0E0E0;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QPushButton[theme="light"]:hover {
    background-color: #D0D0D0;
}

QPushButton[theme="light"]:pressed {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QPushButton#primary_btn[theme="light"] {
    background-color: #7F43E3;
    color: #F2F2F2;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    border: none;
}

QPushButton#primary_btn[theme="light"]:hover {
    background-color: #AD83F3;
}

QLineEdit[theme="light"], QPlainTextEdit[theme="light"], QTextEdit[theme="light"], QSpinBox[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QCheckBox[theme="light"]::indicator {
    width: 18px;
    height: 18px;
    background-color: #F2F2F2;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

QCheckBox[theme="light"]::indicator:checked {
    background-color: #7F43E3;
    border-color: #CCCCCC;
    image: url(":/icons/LightTheme/check.png");
}

QRadioButton[theme="light"]::indicator {
    width: 18px;
    height: 18px;
    background-color: #F2F2F2;
    border: 1px solid #CCCCCC;
    border-radius: 9px;
}

QRadioButton[theme="light"]::indicator:checked {
    image: url(":/icons/LightTheme/radio-checked.png");
    background-color: #F2F2F2;
    border-color: #CCCCCC;
}

QLabel[theme="light"] {
    color: #0D0D0D;
}

QDialog[theme="light"] {
    background-color: #F2F2F2;
}

QSpinBox[theme="light"]::up-button {
    image: url(":/icons/LightTheme/arrow-up.png");
    width: 20px;
    border-radius: 3px;
}

QSpinBox[theme="light"]::down-button {
    image: url(":/icons/LightTheme/arrow-down.png");
    width: 20px;
    border-radius: 3px;
}

QSpinBox[theme="light"]::up-button:hover {
    image: url(":/icons/LightTheme/arrow-up-hover.png");
}

QSpinBox[theme="light"]::down-button:hover {
    image: url(":/icons/LightTheme/arrow-down-hover.png");
    width: 20px;
    border-radius: 3px;
}

QComboBox[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
    padding: 5px;
    border-radius: 4px;
}

QComboBox[theme="light"]:focus {
    border-color: #7F43E3;
}

QComboBox[theme="light"]::drop-down {
    border: none;
    width: 20px;
}

QComboBox[theme="light"]::down-arrow {
    image: url(":/icons/LightTheme/arrow-down.png");
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    padding-right: 10px;
}

QComboBox[theme="light"]::down-arrow:hover {
    image: url(":/icons/LightTheme/arrow-down-hover.png");
}

QScrollBar[theme="light"]:vertical {
    background-color: #F2F2F2;
}

QScrollBar[theme="light"]::handle:vertical {
    background-color: #CCCCCC;
}

QScrollBar[theme="light"]::handle:vertical:hover {
    background-color: #7F43E3;
}

QScrollBar[theme="light"]:horizontal {
    background-color: #F2F2F2;
}

QScrollBar[theme="light"]::handle:horizontal {
    background-color: #CCCCCC;
}

QScrollBar[theme="light"]::handle:horizontal:hover {
    background-color: #7F43E3;
}

QListView[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
    border: 1px solid #CCCCCC;
}

QListView[theme="light"]::item:hover {
    background-color: #D0D0D0;
}

QListView[theme="light"]::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

/* ============================================
   ОБЩИЕ КОМПОНЕНТЫ (РЕФАКТОРИНГ)
   ============================================ */

QGroupBox {
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 8px 8px 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 5px;
    color: #AD83F3;
    font-weight: bold;
}

QPlainTextEdit {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    padding: 5px;
    border-radius: 4px;
}

QPlainTextEdit:focus {
    border-color: #7F43E3;
}

QProgressBar {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    border-radius: 5px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #7F43E3;
    border-radius: 4px;
}

QToolTip {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #7F43E3;
    padding: 4px;
}

QMenuBar {
    background-color: #222222;
    color: #F2F2F2;
}

QMenuBar::item:selected {
    background-color: #3A3A3A;
}

QMenu {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
}

QMenu::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QSplitter::handle {
    background-color: #2A2A2A;
}

QSplitter::handle:hover {
    background-color: #7F43E3;
}

QLabel#hint_label {
    color: #9A9A9A;
    font-size: 12px;
}

QLabel#secondary_label {
    color: #9A9A9A;
}

QLabel#status_label {
    color: #CFCFCF;
}

QPushButton#danger_btn {
    background-color: #5A2A2A;
    border-color: #7A3A3A;
}

QPushButton#danger_btn:hover {
    background-color: #7A3A3A;
}

QFrame#preview_pane {
    background-color: #2A2A2A;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
}

QFrame#preview_pane QLabel {
    background-color: transparent;
}

QTextBrowser {
    background-color: #2A2A2A;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 5px;
}

QLabel#preview_title {
    color: #AD83F3;
    font-weight: bold;
    font-size: 14px;
}

QLabel#preview_image {
    background-color: #1B1B1B;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 6px;
    color: #9A9A9A;
}

QPushButton:disabled, QLineEdit:disabled, QPlainTextEdit:disabled,
QSpinBox:disabled, QComboBox:disabled, QCheckBox:disabled,
QRadioButton:disabled, QLabel:disabled {
    color: #777777;
    background-color: #292929;
}

QCheckBox[theme="light"]::indicator:disabled,
QRadioButton[theme="light"]::indicator:disabled {
    background-color: #E0E0E0;
}

/* --- светлая тема: дополнительные компоненты --- */

QGroupBox[theme="light"] {
    border-color: #CCCCCC;
}

QGroupBox[theme="light"]::title {
    color: #7F43E3;
}

QPlainTextEdit[theme="light"] {
    background-color: #FFFFFF;
    color: #0D0D0D;
    border-color: #CCCCCC;
}

QPlainTextEdit[theme="light"]:focus {
    border-color: #7F43E3;
}

QTextBrowser[theme="light"] {
    background-color: #FFFFFF;
    color: #0D0D0D;
    border-color: #CCCCCC;
}

QProgressBar[theme="light"] {
    background-color: #E0E0E0;
    color: #0D0D0D;
    border-color: #CCCCCC;
}

QProgressBar[theme="light"]::chunk {
    background-color: #7F43E3;
}

QToolTip[theme="light"] {
    background-color: #FFFFFF;
    color: #0D0D0D;
    border-color: #7F43E3;
}

QMenuBar[theme="light"] {
    background-color: #F2F2F2;
    color: #0D0D0D;
}

QMenuBar[theme="light"]::item:selected {
    background-color: #D0D0D0;
}

QMenu[theme="light"] {
    background-color: #FFFFFF;
    color: #0D0D0D;
    border-color: #CCCCCC;
}

QMenu[theme="light"]::item:selected {
    background-color: #7F43E3;
    color: #F2F2F2;
}

QSplitter[theme="light"]::handle {
    background-color: #E0E0E0;
}

QFrame#preview_pane[theme="light"] {
    background-color: #E8E8E8;
    border-color: #CCCCCC;
}

QLabel#preview_image[theme="light"] {
    background-color: #D8D8D8;
    border-color: #BBBBBB;
    color: #666666;
}

QLabel#hint_label[theme="light"],
QLabel#secondary_label[theme="light"] {
    color: #666666;
}

QLabel#status_label[theme="light"] {
    color: #333333;
}

QPushButton#danger_btn[theme="light"] {
    background-color: #F5DCDC;
    border-color: #D9A0A0;
}
