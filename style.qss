/* ============================================================
   AutoFill - modern minimal theme
   Dark is the default; light theme is enabled by theme="light".
   ============================================================ */

QMainWindow,
QDialog {
    background-color: #1A1A1A;
}

QWidget {
    background-color: transparent;
    color: #F2F2F2;
    font-family: "Segoe UI";
    font-size: 13px;
}

QLabel {
    color: #F2F2F2;
    background-color: transparent;
}

QMainWindow#central,
QWidget#central {
    background-color: #1A1A1A;
}

/* ------------------------------------------------------------
   Navigation
   ------------------------------------------------------------ */

QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    background-color: transparent;
    color: #A0A0A0;
    padding: 9px 14px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #262626;
    color: #F2F2F2;
}

QTabBar::tab:selected {
    background-color: #262626;
    border-color: #333333;
    color: #F2F2F2;
}

/* ------------------------------------------------------------
   Cards and sections
   ------------------------------------------------------------ */

QGroupBox {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 12px;
    margin-top: 20px;
    padding: 18px 14px 16px 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    background-color: #202020;
    color: #A0A0A0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

QFrame#preview_pane {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 14px;
}

QFrame#preview_canvas {
    background-color: #171717;
    border: none;
    border-radius: 10px;
}

QFrame#editor_canvas {
    background-color: #171717;
    border: 1px solid #333333;
    border-radius: 12px;
}

QFrame#inspector {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 12px;
}

QScrollArea#inspector_scroll,
QWidget#inspector_content {
    background-color: transparent;
    border: none;
}

QFrame#segmented {
    background-color: #171717;
    border: 1px solid #333333;
    border-radius: 9px;
}

QFrame#action_bar {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 12px;
}

QFrame#dialog_footer {
    border-top: 1px solid #333333;
    background-color: transparent;
}

/* ------------------------------------------------------------
   Typography
   ------------------------------------------------------------ */

QLabel#preview_title {
    color: #F2F2F2;
    font-size: 13px;
    font-weight: 700;
}

QLabel#preview_image {
    background-color: transparent;
    border: none;
    padding: 0;
    color: #A0A0A0;
}

QLabel#dialog_title {
    color: #F2F2F2;
    font-size: 20px;
    font-weight: 700;
}

QLabel#dialog_meta {
    color: #A0A0A0;
    font-size: 12px;
    padding-top: 4px;
}

QLabel#hint_label,
QLabel#secondary_label {
    color: #A0A0A0;
    font-size: 12px;
}

QLabel#status_label {
    color: #A0A0A0;
}

QLabel#zoom_label {
    color: #A0A0A0;
    font-size: 12px;
    padding: 0 6px;
}

QLabel#editor_info {
    color: #A0A0A0;
    font-size: 12px;
    padding: 4px 0;
}

QLabel#inspector_heading {
    color: #A0A0A0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding-top: 6px;
}

QLabel#field_label {
    color: #A0A0A0;
    font-size: 12px;
}

/* ------------------------------------------------------------
   Buttons
   ------------------------------------------------------------ */

QPushButton {
    background-color: #262626;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2E2E2E;
    border-color: #3A3A3A;
}

QPushButton:pressed {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton:disabled {
    color: #6B6B6B;
    background-color: #242424;
    border-color: #303030;
}

QPushButton#primary_btn {
    background-color: #8B5CF6;
    border: 1px solid #8B5CF6;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 700;
}

QPushButton#primary_btn:hover {
    background-color: #A78BFA;
    border-color: #A78BFA;
}

QPushButton#primary_btn:pressed {
    background-color: #7C3AED;
    border-color: #7C3AED;
}

QPushButton#primary_btn:disabled {
    background-color: #4A3A6B;
    border-color: #4A3A6B;
    color: #B8A8D9;
}

QPushButton#secondary_btn {
    background-color: #262626;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 9px 16px;
}

QPushButton#secondary_btn:hover {
    background-color: #2E2E2E;
    border-color: #3A3A3A;
}

QPushButton#tertiary_btn {
    background-color: transparent;
    border: 1px solid transparent;
    color: #A0A0A0;
    padding: 9px 12px;
}

QPushButton#tertiary_btn:hover {
    background-color: #262626;
    color: #F2F2F2;
}

QPushButton#link_btn {
    background-color: transparent;
    border: 1px solid transparent;
    color: #A78BFA;
    padding: 6px 2px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#link_btn:hover {
    color: #C4B5FD;
    background-color: transparent;
}

QPushButton#danger_btn {
    background-color: #3A2424;
    border-color: #6B3535;
    color: #FCA5A5;
}

QPushButton#danger_btn:hover {
    background-color: #4A2A2A;
    border-color: #8B4040;
}

QPushButton#tool_btn {
    background-color: transparent;
    border: 1px solid transparent;
    color: #A0A0A0;
    font-size: 12px;
    padding: 5px 9px;
    border-radius: 7px;
}

QPushButton#tool_btn:hover {
    background-color: #262626;
    border-color: #333333;
    color: #F2F2F2;
}

QPushButton#tool_btn:pressed {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton#seg_btn {
    background-color: transparent;
    border: none;
    color: #A0A0A0;
    padding: 7px 10px;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton#seg_btn:hover {
    color: #F2F2F2;
    background-color: #262626;
}

QPushButton#seg_btn:checked {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton#help_btn {
    background-color: transparent;
    border: 1px solid #333333;
    border-radius: 13px;
    color: #A0A0A0;
    font-weight: 700;
    padding: 0;
}

QPushButton#help_btn:hover {
    color: #F2F2F2;
    border-color: #8B5CF6;
}

QPushButton#color_swatch {
    padding: 0;
    border: 1px solid #3A3A3A;
    border-radius: 9px;
}

QPushButton#color_swatch:hover {
    border-color: #A78BFA;
}

QToolButton#section_toggle {
    background-color: transparent;
    border: none;
    color: #D4D4D4;
    font-weight: 700;
    padding: 6px 0;
    text-align: left;
}

QToolButton#section_toggle:hover {
    color: #F2F2F2;
}

/* ------------------------------------------------------------
   Inputs
   ------------------------------------------------------------ */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QComboBox {
    background-color: #171717;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QSpinBox:hover,
QComboBox:hover {
    border-color: #3A3A3A;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #8B5CF6;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    color: #6B6B6B;
    background-color: #242424;
    border-color: #303030;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(":/icons/BlackTheme/arrow-down.png");
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 6px 8px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 20px;
    border: none;
    background-color: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #2E2E2E;
    border-radius: 4px;
}

QSpinBox::up-arrow {
    image: url(":/icons/BlackTheme/arrow-up.png");
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow {
    image: url(":/icons/BlackTheme/arrow-down.png");
    width: 9px;
    height: 9px;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    background-color: #171717;
    border: 1px solid #3A3A3A;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border-color: #8B5CF6;
}

QCheckBox::indicator:checked {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    image: url(":/icons/BlackTheme/check.png");
}

QRadioButton::indicator {
    width: 17px;
    height: 17px;
    background-color: #171717;
    border: 1px solid #3A3A3A;
    border-radius: 9px;
}

QRadioButton::indicator:hover {
    border-color: #8B5CF6;
}

QRadioButton::indicator:checked {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    image: url(":/icons/BlackTheme/radio-checked.png");
}

QCheckBox#safe_area_check {
    color: #D4D4D4;
    font-size: 12px;
    spacing: 7px;
}

/* ------------------------------------------------------------
   Lists, progress, scrollbars
   ------------------------------------------------------------ */

QListView {
    background-color: #171717;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 4px;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #202020;
    color: #A0A0A0;
    border: none;
    padding: 4px 8px;
}

QListView::item {
    padding: 6px;
    border-radius: 5px;
}

QListView::item:hover {
    background-color: #262626;
}

QListView::item:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QProgressBar {
    background-color: #171717;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 6px;
    text-align: center;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #8B5CF6;
    border-radius: 5px;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8B5CF6;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8B5CF6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:hover {
    background-color: #8B5CF6;
}

/* ------------------------------------------------------------
   Menus and tooltips
   ------------------------------------------------------------ */

QMenuBar {
    background-color: #1A1A1A;
    color: #C7C7C7;
    border: none;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #262626;
    color: #F2F2F2;
}

QMenu {
    background-color: #202020;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 26px 8px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QToolTip {
    background-color: #262626;
    color: #F2F2F2;
    border: 1px solid #3A3A3A;
    border-radius: 0;
    padding: 6px 8px;
}

QTextBrowser {
    background-color: #171717;
    color: #F2F2F2;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 8px;
}

QTextBrowser#message_text {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    color: #F2F2F2;
}

QTextBrowser#message_text[theme="light"] {
    background-color: transparent;
    border: none;
    color: #1F2328;
}

/* ============================================================
   Light theme
   ============================================================ */

QMainWindow[theme="light"],
QDialog[theme="light"] {
    background-color: #F5F6FA;
}

QWidget[theme="light"] {
    background-color: transparent;
    color: #111827;
}

QMainWindow[theme="light"] QWidget#central,
QWidget#central[theme="light"] {
    background-color: #F5F6FA;
}

QTabBar[theme="light"]::tab {
    color: #667085;
}

QTabBar[theme="light"]::tab:hover {
    background-color: #E9EDF5;
    color: #111827;
}

QTabBar[theme="light"]::tab:selected {
    background-color: #E9EDF5;
    border-color: #D8DEE9;
    color: #111827;
}

QGroupBox[theme="light"] {
    background-color: #FFFFFF;
    border-color: #E1E5EE;
}

QGroupBox[theme="light"]::title {
    background-color: #FFFFFF;
    color: #667085;
}

QFrame#preview_pane[theme="light"],
QFrame#inspector[theme="light"],
QFrame#action_bar[theme="light"] {
    background-color: #FFFFFF;
    border-color: #E1E5EE;
}

QFrame#preview_canvas[theme="light"],
QFrame#editor_canvas[theme="light"],
QFrame#segmented[theme="light"] {
    background-color: #F0F2F7;
    border-color: #E1E5EE;
}

QFrame#dialog_footer[theme="light"] {
    border-top-color: #E1E5EE;
}

QLabel[theme="light"] {
    color: #111827;
}

QLabel#preview_title[theme="light"],
QLabel#dialog_title[theme="light"] {
    color: #111827;
}

QLabel#dialog_meta[theme="light"],
QLabel#hint_label[theme="light"],
QLabel#secondary_label[theme="light"],
QLabel#status_label[theme="light"],
QLabel#zoom_label[theme="light"],
QLabel#editor_info[theme="light"],
QLabel#inspector_heading[theme="light"],
QLabel#field_label[theme="light"] {
    color: #667085;
}

QLabel#preview_image[theme="light"] {
    color: #667085;
}

QPushButton[theme="light"] {
    background-color: #F0F2F7;
    color: #111827;
    border-color: #E1E5EE;
}

QPushButton[theme="light"]:hover {
    background-color: #E9EDF5;
    border-color: #CBD2E0;
}

QPushButton[theme="light"]:pressed {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton#primary_btn[theme="light"] {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton#primary_btn[theme="light"]:hover {
    background-color: #A78BFA;
    border-color: #A78BFA;
}

QPushButton#primary_btn[theme="light"]:pressed {
    background-color: #7C3AED;
    border-color: #7C3AED;
}

QPushButton#secondary_btn[theme="light"] {
    background-color: #F0F2F7;
    border-color: #E1E5EE;
}

QPushButton#secondary_btn[theme="light"]:hover {
    background-color: #E9EDF5;
    border-color: #CBD2E0;
}

QPushButton#tertiary_btn[theme="light"] {
    color: #667085;
}

QPushButton#tertiary_btn[theme="light"]:hover {
    background-color: #F0F2F7;
    color: #111827;
}

QPushButton#link_btn[theme="light"] {
    color: #7C3AED;
}

QPushButton#link_btn[theme="light"]:hover {
    color: #6D28D9;
}

QPushButton#tool_btn[theme="light"] {
    color: #667085;
}

QPushButton#tool_btn[theme="light"]:hover {
    background-color: #F0F2F7;
    border-color: #E1E5EE;
    color: #111827;
}

QPushButton#seg_btn[theme="light"] {
    color: #667085;
}

QPushButton#seg_btn[theme="light"]:hover {
    background-color: #FFFFFF;
    color: #111827;
}

QPushButton#seg_btn[theme="light"]:checked {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QPushButton#help_btn[theme="light"] {
    border-color: #E1E5EE;
    color: #667085;
}

QPushButton#help_btn[theme="light"]:hover {
    border-color: #8B5CF6;
    color: #111827;
}

QPushButton#color_swatch[theme="light"] {
    border-color: #CBD2E0;
}

QToolButton#section_toggle[theme="light"] {
    color: #344054;
}

QToolButton#section_toggle[theme="light"]:hover {
    color: #111827;
}

QLineEdit[theme="light"],
QPlainTextEdit[theme="light"],
QTextEdit[theme="light"],
QSpinBox[theme="light"],
QComboBox[theme="light"] {
    background-color: #FFFFFF;
    color: #111827;
    border-color: #E1E5EE;
}

QLineEdit[theme="light"]:hover,
QPlainTextEdit[theme="light"]:hover,
QTextEdit[theme="light"]:hover,
QSpinBox[theme="light"]:hover,
QComboBox[theme="light"]:hover {
    border-color: #CBD2E0;
}

QLineEdit[theme="light"]:focus,
QPlainTextEdit[theme="light"]:focus,
QTextEdit[theme="light"]:focus,
QSpinBox[theme="light"]:focus,
QComboBox[theme="light"]:focus {
    border-color: #8B5CF6;
}

QSpinBox[theme="light"]::up-button:hover,
QSpinBox[theme="light"]::down-button:hover {
    background-color: #F0F2F7;
}

QSpinBox[theme="light"]::up-arrow {
    image: url(":/icons/LightTheme/arrow-up.png");
}

QSpinBox[theme="light"]::down-arrow,
QComboBox[theme="light"]::down-arrow {
    image: url(":/icons/LightTheme/arrow-down.png");
}

QScrollBar[theme="light"]:vertical,
QScrollBar[theme="light"]:horizontal {
    background-color: transparent;
}

QScrollBar[theme="light"]::handle:vertical,
QScrollBar[theme="light"]::handle:horizontal {
    background-color: #CBD2E0;
}

QScrollBar[theme="light"]::handle:vertical:hover,
QScrollBar[theme="light"]::handle:horizontal:hover {
    background-color: #8B5CF6;
}

QCheckBox[theme="light"]::indicator,
QRadioButton[theme="light"]::indicator {
    background-color: #FFFFFF;
    border-color: #CBD2E0;
}

QCheckBox[theme="light"]::indicator:checked,
QRadioButton[theme="light"]::indicator:checked {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
}

QCheckBox[theme="light"]::indicator:checked {
    image: url(":/icons/LightTheme/check.png");
}

QRadioButton[theme="light"]::indicator:checked {
    image: url(":/icons/LightTheme/radio-checked.png");
}

QCheckBox#safe_area_check[theme="light"] {
    color: #344054;
}

QListView[theme="light"] {
    background-color: #FFFFFF;
    color: #111827;
    border-color: #E1E5EE;
}

QHeaderView[theme="light"]::section {
    background-color: #F0F2F7;
    color: #667085;
}

QListView[theme="light"]::item:hover {
    background-color: #F0F2F7;
}

QListView[theme="light"]::item:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QProgressBar[theme="light"] {
    background-color: #F0F2F7;
    color: #111827;
    border-color: #E1E5EE;
}

QMenuBar[theme="light"] {
    background-color: #F5F6FA;
    color: #667085;
}

QMenuBar[theme="light"]::item:selected {
    background-color: #E9EDF5;
    color: #111827;
}

QMenu[theme="light"] {
    background-color: #FFFFFF;
    color: #111827;
    border-color: #E1E5EE;
}

QToolTip[theme="light"] {
    background-color: #FFFFFF;
    color: #111827;
    border-color: #CBD2E0;
}

QTextBrowser[theme="light"] {
    background-color: #FFFFFF;
    color: #111827;
    border-color: #E1E5EE;
}

QPushButton#danger_btn[theme="light"] {
    background-color: #FEF2F2;
    border-color: #FCA5A5;
    color: #B91C1C;
}

/* QWidget сбрасывает фон в transparent, поэтому диалогам нужен явный фон
   после общих правил - иначе тёмная тема даёт чёрные полосы, а светлая
   тема теряет фон вокруг шапки и футера. */
QDialog {
    background-color: #1A1A1A;
}

QDialog[theme="light"] {
    background-color: #F5F6FA;
}
